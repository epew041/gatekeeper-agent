# Salin file ini menjadi `.env` dan isi dengan nilai ASLI dari dashboard/hosting.
# JANGAN pernah commit file `.env` atau membagikan isinya di chat.
# Nilai di bawah ini HANYA placeholder.

# Port server lokal (hosting biasanya mengatur PORT sendiri).
PORT=3000

# Secret HMAC 32-byte dari Agent Games, ditampilkan SEKALI saat registrasi agent
# di dashboard (Manage agents). Tempel persis apa adanya.
AGENT_HMAC_SECRET=PASTE_HMAC_SECRET_FROM_DASHBOARD_HERE

# API key Kurier mainnet (dibuat sendiri dengan mendaftar di situs Kurier;
# lihat README.md). Tanpa ini, agent TIDAK mengirim proof ke zkVerify.
KURIER_API_KEY=PASTE_KURIER_MAINNET_API_KEY_HERE

# Hash verification key circuit gatekeeper (sudah terdaftar di zkVerify mainnet).
# Nilai default di bawah adalah nilai resmi dari /api/circuit-info.
VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0

# Base URL Kurier mainnet (default resmi dari docs.zkverify.io).
KURIER_API_URL=https://api.kurier.xyz/api/v1

# Batas waktu total menangani satu task, dalam milidetik. Harus di bawah
# deadline 60 detik platform. Default 50 detik.
TASK_TIMEOUT_MS=50000

# File penyimpanan seen-set (proof ref yang sudah dipakai) agar reuse
# terdeteksi antar restart. Kosongkan untuk mode in-memory saja.
SEEN_SET_PATH=./seen-set.json
